# ===================================================================
# EV Charging Station Placement & Route Planning - Environment Config
# Copy to .env for local development, or set as env vars on Render.
# ===================================================================

# ---- External API Keys (optional - app works with OSM free tier) ----
OPENCHARGEMAP_API_KEY=
OPENROUTESERVICE_API_KEY=
HEIGIT_API_KEY=

# ---- Server ----
APP_HOST=0.0.0.0
APP_PORT=8085

# ---- Security: CORS origin allowlist (comma-separated) ----
CORS_ORIGINS=http://localhost:8085,http://127.0.0.1:8085

# ---- Rate limits ----
RATE_LIMITS=/api/geocode:30:60,/api/charging-stations:20:60,/api/mst:15:60,/api/dijkstra:15:60,/api/knapsack:30:60,/api/distance-matrix:15:60,/api/route:15:60

# ---- Request body limit (bytes) ----
MAX_REQUEST_BYTES=2097152

# ---- Input bounds ----
MAX_STATIONS_PER_REQUEST=30
MAX_MATRIX_LOCATIONS=25
MAX_KNAPSACK_CANDIDATES=200
MAX_BUDGET=1000000000
MAX_QUERY_LENGTH=200
MAX_NAME_LENGTH=200
MAX_ID_LENGTH=100

# ---- Geocode cache bound ----
GEOCODE_CACHE_SIZE=200
